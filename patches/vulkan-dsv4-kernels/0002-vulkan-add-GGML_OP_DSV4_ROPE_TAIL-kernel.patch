+// GGML_OP_DSV4_ROPE_TAIL
+struct test_dsv4_rope_tail : public test_case {
+    const ggml_type type;
+    const std::array<int64_t, 4> ne; // [n_embd_head, n_head, n_tokens, batch]
+    const int n_dims;    // n_rot: width of the roped tail; the leading ne0 - n_dims are copied through
+    const int mode;      // GGML_ROPE_TYPE_NORMAL or GGML_ROPE_TYPE_NEOX
+    const int n_ctx;     // used to generate positions
+    const float fs;      // freq_scale
+    const float ef;      // ext_factor
+    const float af;      // attn_factor
+    const bool ff;       // freq_factors present
+    const bool inverse;  // un-RoPE (negates sin)
+    const int v;         // view (1 : non-contiguous a)
+
+    std::string vars() override {
+        return VARS_TO_STR11(type, ne, n_dims, mode, n_ctx, fs, ef, af, ff, inverse, v);
+    }
+
+    test_dsv4_rope_tail(ggml_type type = GGML_TYPE_F32,
+            std::array<int64_t, 4> ne = {576, 2, 7, 1},
+            int n_dims = 64, int mode = GGML_ROPE_TYPE_NEOX, int n_ctx = 512,
+            float fs = 1.0f, float ef = 0.0f, float af = 1.0f,
+            bool ff = false, bool inverse = false, int v = 0)
+        : type(type), ne(ne), n_dims(n_dims), mode(mode), n_ctx(n_ctx),
+          fs(fs), ef(ef), af(af), ff(ff), inverse(inverse), v(v) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a;
+        if (v & 1) {
+            auto ne_big = ne; ne_big[0] *= 2; ne_big[1] *= 4; ne_big[2] *= 3;
+            a = ggml_new_tensor(ctx, type, 4, ne_big.data());
+            ggml_set_name(a, "a");
+
+            a = ggml_view_4d(ctx, a, ne[0], ne[1], ne[2], ne[3], a->nb[1], a->nb[2], a->nb[3], 0);
+            ggml_set_name(a, "view_of_a");
+        } else {
+            a = ggml_new_tensor(ctx, type, 4, ne.data());
+            ggml_set_name(a, "a");
+        }
+
+        ggml_tensor * pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, ne[2]);
+        ggml_set_name(pos, "pos");
+
+        ggml_tensor * freq = nullptr;
+        if (ff) {
+            freq = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_dims/2);
+            ggml_set_name(freq, "freq");
+        }
+
+        ggml_tensor * out = ggml_dsv4_rope_tail(ctx, a, pos, freq, n_dims, mode, 0,
+                10000.0f, fs, ef, af, 1.0f, 1.0f, inverse);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type == GGML_TYPE_I32) {
+                // pos
+                const int n_pos = (int) ne[2];
+                std::vector<int> data(n_pos);
+                for (int i = 0; i < n_pos; i++) {
+                    data[i] = rand() % n_ctx;
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, n_pos * sizeof(int));
+            } else {
