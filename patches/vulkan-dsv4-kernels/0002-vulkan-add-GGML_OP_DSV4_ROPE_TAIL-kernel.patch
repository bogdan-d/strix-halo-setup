diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_rope_tail.comp b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_rope_tail.comp
new file mode 100644
index 0000000..d12542c
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_rope_tail.comp
@@ -0,0 +1,83 @@
+#version 450
+
+#include "rope_head.glsl"
+#include "rope_funcs.glsl"
+
+// DeepSeek-V4 partial RoPE ("tail").
+//
+// Each row is [ne00] wide and splits into a "nope" prefix of n_nope = ne00 - n_dims
+// elements that is copied through unchanged, followed by an n_dims-wide tail that is
+// rotary-embedded exactly like a normal/neox RoPE over an n_dims head. This mirrors
+// ggml_compute_forward_dsv4_rope_tail (ggml-cpu/ops.cpp) and kernel_dsv4_rope_tail_f32
+// (ggml-metal.metal), and reuses the shared rope_yarn() so the numerics match the
+// mainline RoPE shaders (and therefore the CPU reference within tolerance).
+//
+// The `inverse` op flag is carried in pc.is_back: rope_yarn() negates theta when
+// is_back != 0, which flips the sign of sin while leaving cos unchanged - identical to
+// the CPU's sin_sign = -1 path.
+//
+// One thread per output element (gl_GlobalInvocationID.y == element index i0). n_nope
+// may be odd, so the copy region is handled element-wise. Each rotation is performed by
+// the thread that owns the first element of the pair, which also writes the partner.
+
+void main() {
+    const uint i0  = gl_GlobalInvocationID.y;
+    const uint row = gl_GlobalInvocationID.x + 32768 * gl_GlobalInvocationID.z;
+    if (row >= pc.nrows || i0 >= pc.ne00) {
+        return;
+    }
+
+    const uint i3 = row / (pc.ne01*pc.ne02);
+    const uint i2 = (row - i3 * pc.ne01*pc.ne02) / pc.ne01;
+    const uint i1 = (row - i3 * pc.ne01*pc.ne02 - i2 * pc.ne01);
+
+    // dim-0 stride is 1 element (contiguous rows, gated in supports_op)
+    const uint a_row = i3*pc.nb03 + i2*pc.nb02 + i1*pc.nb01;
+    const uint d_row = i3*pc.nb13 + i2*pc.nb12 + i1*pc.nb11;
+
+    const uint n_nope = pc.ne00 - pc.n_dims;
+
+    // nope prefix: straight pass-through copy
+    if (i0 < n_nope) {
+        rope_data_d[d_row + i0] = ROPE_D_TYPE(rope_data_a[a_row + i0]);
+        return;
+    }
+
+    const uint r = i0 - n_nope;                       // position within the tail, [0, n_dims)
+    const bool is_neox = (pc.rope_mode & 2u) != 0u;   // GGML_ROPE_TYPE_NEOX == 2
+
+    uint k;        // pair index, indexes freq factors
+    uint j0, j1;   // element offsets of the rotated pair within the row
+    uint i0_yarn;  // == 2*k, the ramp/theta index expected by rope_yarn (CPU cache i0)
+
+    if (is_neox) {
+        const uint n_half = pc.n_dims / 2;
+        if (r >= n_half) {
+            return;                                   // second half of a pair: written by its partner
+        }
+        k       = r;
+        j0      = n_nope + r;
+        j1      = n_nope + r + n_half;
+        i0_yarn = 2u * r;
+    } else {
+        if ((r & 1u) != 0u) {
+            return;                                   // odd element: written by its even partner
+        }
+        k       = r / 2u;
+        j0      = n_nope + r;
+        j1      = n_nope + r + 1u;
+        i0_yarn = r;
+    }
+
+    const float theta_base  = float(rope_data_pos[i2]) * pow(pc.theta_scale, float(i0_yarn)/2.0f);
+    const float freq_factor = pc.has_ff != 0 ? rope_data_ff[k] : 1.0f;
+
+    float cos_theta, sin_theta;
+    rope_yarn(theta_base / freq_factor, i0_yarn, cos_theta, sin_theta, pc);
+
+    const float x0 = float(rope_data_a[a_row + j0]);
+    const float x1 = float(rope_data_a[a_row + j1]);
+
+    rope_data_d[d_row + j0] = ROPE_D_TYPE(x0*cos_theta - x1*sin_theta);
+    rope_data_d[d_row + j1] = ROPE_D_TYPE(x0*sin_theta + x1*cos_theta);
+}
