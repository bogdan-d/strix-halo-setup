diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_split_sinkhorn.comp b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_split_sinkhorn.comp
new file mode 100644
index 0000000..c655c7e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_split_sinkhorn.comp
@@ -0,0 +1,158 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+// DeepSeek-V4 hyperconnection split + Sinkhorn normalization.
+//
+// One workgroup per row of mixes ([(2 + n_hc)*n_hc, n_rows]). Each row is split into
+//   out[0       .. n_hc)      = sigmoid(mix*pre_scale  + base) + eps
+//   out[n_hc    .. 2*n_hc)    = 2*sigmoid(mix*post_scale + base)
+//   out[2*n_hc  .. 2*n_hc+n_hc*n_hc) = the n_hc x n_hc comb matrix, row-softmaxed
+//     (+eps), then Sinkhorn-normalized: one column pass, then sinkhorn_iters - 1
+//     further (row, column) pairs, each dividing by (sum + eps).
+//
+// Mirrors ggml_compute_forward_dsv4_hc_split_sinkhorn (ggml-cpu/ops.cpp) and
+// kernel_dsv4_hc_split_sinkhorn (ggml-metal.metal). sh_c is indexed
+// [src_hc + dst_hc*n_hc] exactly like the CPU reference, and every reduction runs
+// serially inside one thread over the same ascending index order as the CPU loops,
+// so the only numeric difference vs the CPU is exp() vs expf().
+//
+// n_hc <= 16 (asserted by the CPU op and gated in supports_op), so the comb matrix
+// fits in a 256-float shared array.
+
+layout (push_constant) uniform parameter
+{
+    uint  n_rows;
+    uint  mix_hc;             // (2 + n_hc) * n_hc
+    uint  n_hc;
+    uint  sinkhorn_iters;
+    float eps;
+    uint  nb_mix1;            // mixes row stride, in elements
+    uint  nb_d1;              // dst row stride, in elements
+    uint  mix_offset; uint scale_offset; uint base_offset; uint d_offset;
+} p;
+
+layout (binding = 0) readonly  buffer MIX   {A_TYPE data_mix[];};
+layout (binding = 1) readonly  buffer SCALE {A_TYPE data_scale[];};
+layout (binding = 2) readonly  buffer BASE  {A_TYPE data_base[];};
+layout (binding = 3) writeonly buffer DST   {D_TYPE data_d[];};
+
+const uint num_threads = 64;
+
+layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;
+
+shared float sh_c[16*16];
+
+void main() {
+    // row is workgroup-uniform, so the early-out below never splits a barrier
+    const uint row = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x;
+    const uint tid = gl_LocalInvocationID.x;
+
+    if (row >= p.n_rows) {
+        return;
+    }
+
+    const uint  n_hc     = p.n_hc;
+    const uint  mix_base = p.mix_offset + row*p.nb_mix1;
+    const uint  d_base   = p.d_offset   + row*p.nb_d1;
+    const float eps      = p.eps;
+
+    const float pre_scale  = float(data_scale[p.scale_offset + 0]);
+    const float post_scale = float(data_scale[p.scale_offset + 1]);
+    const float comb_scale = float(data_scale[p.scale_offset + 2]);
+
+    // pre gates: sigmoid + eps
+    for (uint i = tid; i < n_hc; i += num_threads) {
+        const float z = float(data_mix[mix_base + i])*pre_scale + float(data_base[p.base_offset + i]);
+        data_d[d_base + i] = D_TYPE(1.0f / (1.0f + exp(-z)) + eps);
+    }
+
+    // post gates: 2 * sigmoid
+    for (uint i = tid; i < n_hc; i += num_threads) {
+        const uint off = n_hc + i;
+        const float z = float(data_mix[mix_base + off])*post_scale + float(data_base[p.base_offset + off]);
+        data_d[d_base + off] = D_TYPE(2.0f / (1.0f + exp(-z)));
+    }
+
+    // comb: softmax each dst_hc row over src_hc, then +eps. Thread dst_hc owns one row.
+    if (tid < n_hc) {
+        const uint dst_hc = tid;
+
+        float row_max = uintBitsToFloat(0xff800000u); // -inf
+        for (uint src_hc = 0; src_hc < n_hc; ++src_hc) {
+            const uint idx = src_hc + dst_hc*n_hc;
+            const uint off = 2*n_hc + idx;
+            const float v = float(data_mix[mix_base + off])*comb_scale + float(data_base[p.base_offset + off]);
+            sh_c[idx] = v;
+            row_max = max(row_max, v);
+        }
+
+        float row_sum = 0.0f;
+        for (uint src_hc = 0; src_hc < n_hc; ++src_hc) {
+            const uint idx = src_hc + dst_hc*n_hc;
+            const float v = exp(sh_c[idx] - row_max);
+            sh_c[idx] = v;
+            row_sum += v;
+        }
+
+        const float inv_sum = 1.0f / row_sum;
+        for (uint src_hc = 0; src_hc < n_hc; ++src_hc) {
+            const uint idx = src_hc + dst_hc*n_hc;
+            sh_c[idx] = sh_c[idx] * inv_sum + eps;
+        }
+    }
+    barrier();
+
+    // first Sinkhorn pass is column-only. Thread src_hc owns one column.
+    if (tid < n_hc) {
+        const uint src_hc = tid;
+
+        float sum = 0.0f;
+        for (uint dst_hc = 0; dst_hc < n_hc; ++dst_hc) {
+            sum += sh_c[src_hc + dst_hc*n_hc];
+        }
+
+        const float inv_denom = 1.0f / (sum + eps);
+        for (uint dst_hc = 0; dst_hc < n_hc; ++dst_hc) {
+            sh_c[src_hc + dst_hc*n_hc] *= inv_denom;
+        }
+    }
+    barrier();
+
+    // sinkhorn_iters is a push constant, so this loop (and its barriers) is uniform
+    for (uint iter = 1; iter < p.sinkhorn_iters; ++iter) {
+        if (tid < n_hc) {
+            const uint dst_hc = tid;
+
+            float sum = 0.0f;
+            for (uint src_hc = 0; src_hc < n_hc; ++src_hc) {
+                sum += sh_c[src_hc + dst_hc*n_hc];
+            }
+
+            const float inv_denom = 1.0f / (sum + eps);
+            for (uint src_hc = 0; src_hc < n_hc; ++src_hc) {
+                sh_c[src_hc + dst_hc*n_hc] *= inv_denom;
+            }
+        }
+        barrier();
+
+        if (tid < n_hc) {
+            const uint src_hc = tid;
+
+            float sum = 0.0f;
+            for (uint dst_hc = 0; dst_hc < n_hc; ++dst_hc) {
+                sum += sh_c[src_hc + dst_hc*n_hc];
+            }
+
+            const float inv_denom = 1.0f / (sum + eps);
+            for (uint dst_hc = 0; dst_hc < n_hc; ++dst_hc) {
+                sh_c[src_hc + dst_hc*n_hc] *= inv_denom;
+            }
+        }
+        barrier();
+    }
+
+    for (uint i = tid; i < n_hc*n_hc; i += num_threads) {
+        data_d[d_base + 2*n_hc + i] = D_TYPE(sh_c[i]);
+    }
+}
