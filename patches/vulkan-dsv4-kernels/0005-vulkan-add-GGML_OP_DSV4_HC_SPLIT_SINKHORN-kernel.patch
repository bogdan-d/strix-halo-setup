+// GGML_OP_DSV4_HC_SPLIT_SINKHORN
+struct test_dsv4_hc_split_sinkhorn : public test_case {
+    const ggml_type type;
+    const int64_t n_hc;
+    const int64_t n_tokens;
+    const int sinkhorn_iters;
+    const float eps;
+    const int v;       // view (1 : padded-stride rows on mixes)
+    const float range; // magnitude of the random mixes/scale/base values
+
+    std::string vars() override {
+        return VARS_TO_STR7(type, n_hc, n_tokens, sinkhorn_iters, eps, v, range);
+    }
+
+    test_dsv4_hc_split_sinkhorn(ggml_type type = GGML_TYPE_F32,
+            int64_t n_hc = 4, int64_t n_tokens = 7, int sinkhorn_iters = 3,
+            float eps = 1e-6f, int v = 0, float range = 1.0f)
+        : type(type), n_hc(n_hc), n_tokens(n_tokens), sinkhorn_iters(sinkhorn_iters),
+          eps(eps), v(v), range(range) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t mix_hc = (2 + n_hc)*n_hc;
+
+        ggml_tensor * mixes;
+        if (v & 1) {
+            ggml_tensor * big = ggml_new_tensor_2d(ctx, type, mix_hc*2, n_tokens*3);
+            ggml_set_name(big, "mixes_big");
+            mixes = ggml_view_2d(ctx, big, mix_hc, n_tokens, big->nb[1], 0);
+        } else {
+            mixes = ggml_new_tensor_2d(ctx, type, mix_hc, n_tokens);
+        }
+        ggml_set_name(mixes, "mixes");
+
+        // model shapes: hc_*_scale is [3], hc_*_base is [(2 + n_hc)*n_hc]
+        ggml_tensor * scale = ggml_new_tensor_1d(ctx, type, 3);
+        ggml_set_name(scale, "scale");
+
+        ggml_tensor * base = ggml_new_tensor_1d(ctx, type, mix_hc);
+        ggml_set_name(base, "base");
+
+        ggml_tensor * out = ggml_dsv4_hc_split_sinkhorn(ctx, mixes, scale, base, (int) n_hc, sinkhorn_iters, eps);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            init_tensor_uniform(t, -range, range);
+        }
+    }
+};
