index 0000000..969f96d
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_fp8_kv_quantize.comp
@@ -0,0 +1,89 @@
+#version 450
+
+#include "generic_unary_head.glsl"
+
+// One workgroup per row. The first ne00 - n_rot elements of each row are quantized
+// to E4M3FN (simulated in f32) in blocks of 64 with a shared power-of-two scale per
+// block; the last n_rot elements (the RoPE tail) are copied through unchanged.
+// Mirrors ggml_compute_forward_dsv4_fp8_kv_quantize (ggml-cpu/ops.cpp) and
+// kernel_dsv4_fp8_kv_quantize_f32 (ggml-metal.metal).
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+shared float sh_amax[64];
+
+// Direct f32 -> E4M3FN round-trip with round-to-nearest-even on the E4M3FN value
+// grid. Bit-exact with the CPU's brute-force nearest-value search
+// (ggml_dsv4_e4m3fn_dequant): that search's tie-break prefers the even code, which
+// is exactly ties-to-even on the 3-bit mantissa, and its value set is
+//   mant * 2^-9 (denormals) and (1 + mant/8) * 2^(exp-7), capped at 448.
+// The input must already be clamped to [-448, 448]. Every operation below is exact
+// in f32 (power-of-two scaling and roundEven only), so there is no precision drift
+// vs the CPU implementation. Verified exhaustively over the full input range.
+float dsv4_e4m3fn_rne(const float x) {
+    const float a = abs(x);
+    float q;
+    if (a < 0.015625f) {
+        // below 2^-6: E4M3FN denormal grid, step 2^-9
+        q = roundEven(a * 512.0f) * 0.001953125f;
+    } else {
+        // normal grid: step 2^(e-3) for a in [2^e, 2^(e+1)), e = unbiased exponent
+        const uint eb = (floatBitsToUint(a) >> 23) & 0xffu;            // biased exponent, 121..135
+        const float quantum     = uintBitsToFloat((eb -   3u) << 23);  // 2^(e-3)
+        const float inv_quantum = uintBitsToFloat((257u - eb) << 23);  // 2^-(e-3)
+        q = roundEven(a * inv_quantum) * quantum;                      // a*inv_quantum in [8, 16]
+    }
+    return x < 0.0f ? -q : q;
+}
+
+void main() {
+    const uint row   = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x;
+    const uint tid   = gl_LocalInvocationID.x;
+    const uint nrows = p.ne01 * p.ne02 * p.ne03;
+
+    if (row >= nrows) {
+        return;
+    }
+
+    const uint i1 = row % p.ne01;
+    const uint i2 = (row / p.ne01) % p.ne02;
+    const uint i3 = row / (p.ne01 * p.ne02);
+
+    const uint a_base = get_aoffset() + i1*p.nb01 + i2*p.nb02 + i3*p.nb03;
+    const uint d_base = get_doffset() + i1*p.nb11 + i2*p.nb12 + i3*p.nb13;
+
+    const uint n_rot  = uint(p.param1); // op_params[0], exact in f32 for any head size
+    const uint n_nope = p.ne00 - n_rot; // multiple of 64, asserted at graph build
+
+    for (uint off = 0; off < n_nope; off += 64) {
+        const float v = float(data_a[a_base + (off + tid)*p.nb00]);
+        sh_amax[tid] = abs(v);
+        barrier();
+        [[unroll]] for (uint s = 32; s > 0; s >>= 1) {
+            if (tid < s) {
+                sh_amax[tid] = max(sh_amax[tid], sh_amax[tid + s]);
+            }
+            barrier();
+        }
+        const float amax = max(sh_amax[0], 1.0e-4f);
+
+        // scale = 2^k with k = ceil(log2(amax/448)), i.e. the smallest power of two
+        // with 448*2^k >= amax. Computed with integer logic instead of log2/division
+        // so the result is exact: 448*2^(e-8) = 1.75*2^e >= amax iff the mantissa
+        // field of amax is <= 0.75 * 2^23.
+        const uint abits = floatBitsToUint(amax);
+        const int  e     = int((abits >> 23) & 0xffu) - 127;
+        const int  k     = ((abits & 0x7fffffu) <= 0x600000u) ? e - 8 : e - 7;
+        const float scale     = uintBitsToFloat(uint(k + 127) << 23);
+        const float inv_scale = uintBitsToFloat(uint(127 - k) << 23);
+
+        data_d[d_base + (off + tid)*p.nb10] =
+            D_TYPE(dsv4_e4m3fn_rne(clamp(v * inv_scale, -448.0f, 448.0f)) * scale);
+        barrier(); // sh_amax is reused by the next block
+    }
+
+    // RoPE tail [n_nope, ne00): pass-through copy
+    for (uint i = n_nope + tid; i < p.ne00; i += 64) {
+        data_d[d_base + i*p.nb10] = data_a[a_base + i*p.nb00];
+    }
+}
