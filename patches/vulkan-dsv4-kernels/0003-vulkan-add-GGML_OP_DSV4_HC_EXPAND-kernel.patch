diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_expand.comp b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_expand.comp
new file mode 100644
index 0000000..fe82298
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_expand.comp
@@ -0,0 +1,69 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+// DeepSeek-V4 hyperconnection expand:
+//   out[d, dst_hc, t] = block_out[d, t] * post[dst_hc, t]
+//                     + sum_src_hc comb[dst_hc, src_hc, t] * residual[d, src_hc, t]
+// One thread per output element over ne = n_embd * n_hc * n_tokens, in the same
+// flat order and with the same comb indexing (dim0 = dst_hc, dim1 = src_hc) as
+// ggml_compute_forward_dsv4_hc_expand (ggml-cpu/ops.cpp) and
+// kernel_dsv4_hc_expand (ggml-metal.metal). All strides are in elements and come
+// from the tensors, so non-contiguous views (the model's n_tokens == 1 decode
+// path passes post/comb as strided views into the sinkhorn split) work directly.
+
+layout (push_constant) uniform parameter
+{
+    uint ne;                                    // n_embd * n_hc * n_tokens
+    uint n_embd;
+    uint n_hc;
+    uint nb_block0; uint nb_block1;             // block_out strides
+    uint nb_res0;   uint nb_res1;  uint nb_res2;
+    uint nb_post0;  uint nb_post1;
+    uint nb_comb0;  uint nb_comb1; uint nb_comb2;
+    uint nb_d0;     uint nb_d1;    uint nb_d2;
+    uint block_offset; uint res_offset; uint post_offset; uint comb_offset; uint d_offset;
+} p;
+
+layout (binding = 0) readonly  buffer BLK  {A_TYPE data_block[];};
+layout (binding = 1) readonly  buffer RES  {A_TYPE data_res[];};
+layout (binding = 2) readonly  buffer POST {A_TYPE data_post[];};
+layout (binding = 3) readonly  buffer COMB {A_TYPE data_comb[];};
+layout (binding = 4) writeonly buffer DST  {D_TYPE data_d[];};
+
+const uint num_threads = 256;
+
+layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    uint idx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
+
+    // num_threads * num_iter must equal 512, to match the wg_denoms and the idx calculation
+    const uint num_iter = 2;
+
+    [[unroll]] for (uint i = 0; i < num_iter; ++i) {
+        if (idx >= p.ne) {
+            idx += num_threads;
+            continue;
+        }
+
+        const uint d      = idx % p.n_embd;
+        const uint tmp    = idx / p.n_embd;
+        const uint dst_hc = tmp % p.n_hc;
+        const uint t      = tmp / p.n_hc;
+
+        const float block_v = float(data_block[p.block_offset + d*p.nb_block0 + t*p.nb_block1]);
+        const float post_v  = float(data_post [p.post_offset + dst_hc*p.nb_post0 + t*p.nb_post1]);
+
+        float acc = block_v * post_v;
+        for (uint src_hc = 0; src_hc < p.n_hc; ++src_hc) {
+            const float comb_v = float(data_comb[p.comb_offset + dst_hc*p.nb_comb0 + src_hc*p.nb_comb1 + t*p.nb_comb2]);
+            const float res_v  = float(data_res [p.res_offset  + d*p.nb_res0 + src_hc*p.nb_res1 + t*p.nb_res2]);
+            acc += comb_v * res_v;
+        }
+
+        data_d[p.d_offset + d*p.nb_d0 + dst_hc*p.nb_d1 + t*p.nb_d2] = D_TYPE(acc);
+
+        idx += num_threads;
+    }
+}
