+// GGML_OP_DSV4_HC_EXPAND
+struct test_dsv4_hc_expand : public test_case {
+    const ggml_type type;
+    const std::array<int64_t, 3> ne; // [n_embd, n_hc, n_tokens]
+    const int v; // 0: contiguous; 1: padded-stride views; 2: model decode layout (post/comb offset views into a sinkhorn split)
+
+    std::string vars() override {
+        return VARS_TO_STR3(type, ne, v);
+    }
+
+    test_dsv4_hc_expand(ggml_type type = GGML_TYPE_F32,
+            std::array<int64_t, 3> ne = {7168, 4, 7}, int v = 0)
+        : type(type), ne(ne), v(v) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t n_embd = ne[0], n_hc = ne[1], n_tokens = ne[2];
+
+        ggml_tensor * block = ggml_new_tensor_2d(ctx, type, n_embd, n_tokens);
+        ggml_set_name(block, "block_out");
+
+        ggml_tensor * residual;
+        ggml_tensor * post;
+        ggml_tensor * comb;
+        if (v == 1) {
+            // padded-stride views at offset 0
+            ggml_tensor * res_big = ggml_new_tensor_3d(ctx, type, n_embd*2, n_hc, n_tokens*3);
+            ggml_set_name(res_big, "res_big");
+            residual = ggml_view_3d(ctx, res_big, n_embd, n_hc, n_tokens, res_big->nb[1], res_big->nb[2], 0);
+
+            ggml_tensor * post_big = ggml_new_tensor_2d(ctx, type, n_hc*3, n_tokens);
+            ggml_set_name(post_big, "post_big");
+            post = ggml_view_2d(ctx, post_big, n_hc, n_tokens, post_big->nb[1], 0);
+
+            ggml_tensor * comb_big = ggml_new_tensor_3d(ctx, type, n_hc, n_hc*2, n_tokens);
+            ggml_set_name(comb_big, "comb_big");
+            comb = ggml_view_3d(ctx, comb_big, n_hc, n_hc, n_tokens, comb_big->nb[1], comb_big->nb[2], 0);
+        } else if (v == 2) {
+            // model decode path (dsv4_hc_pre/post with n_tokens == 1): post and comb are
+            // strided views into the [(2 + n_hc)*n_hc, n_tokens] sinkhorn split at element
+            // offsets n_hc and 2*n_hc
+            residual = ggml_new_tensor_3d(ctx, type, n_embd, n_hc, n_tokens);
+
+            ggml_tensor * split = ggml_new_tensor_2d(ctx, type, (2 + n_hc)*n_hc, n_tokens);
+            ggml_set_name(split, "split");
+            post = ggml_view_2d(ctx, split, n_hc, n_tokens, split->nb[1], n_hc*split->nb[0]);
+            comb = ggml_view_3d(ctx, split, n_hc, n_hc, n_tokens, n_hc*split->nb[0], split->nb[1], 2*n_hc*split->nb[0]);
+        } else {
+            residual = ggml_new_tensor_3d(ctx, type, n_embd, n_hc, n_tokens);
+            post     = ggml_new_tensor_2d(ctx, type, n_hc, n_tokens);
+            comb     = ggml_new_tensor_3d(ctx, type, n_hc, n_hc, n_tokens);
+        }
+        ggml_set_name(residual, "residual");
+        ggml_set_name(post, "post");
+        ggml_set_name(comb, "comb");
+
+        ggml_tensor * out = ggml_dsv4_hc_expand(ctx, block, residual, post, comb);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+};
