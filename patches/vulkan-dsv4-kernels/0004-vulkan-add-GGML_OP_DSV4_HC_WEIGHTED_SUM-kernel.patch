+// GGML_OP_DSV4_HC_WEIGHTED_SUM
+struct test_dsv4_hc_weighted_sum : public test_case {
+    const ggml_type type;
+    const std::array<int64_t, 3> ne; // [n_embd, n_hc, n_tokens]
+    const int v; // 0: contiguous; 1: padded-stride views; 2: model decode layout (weights = offset view into a sinkhorn split)
+
+    std::string vars() override {
+        return VARS_TO_STR3(type, ne, v);
+    }
+
+    test_dsv4_hc_weighted_sum(ggml_type type = GGML_TYPE_F32,
+            std::array<int64_t, 3> ne = {7168, 4, 7}, int v = 0)
+        : type(type), ne(ne), v(v) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t n_embd = ne[0], n_hc = ne[1], n_tokens = ne[2];
+
+        ggml_tensor * x;
+        ggml_tensor * w;
+        if (v == 1) {
+            // padded-stride views at offset 0
+            ggml_tensor * x_big = ggml_new_tensor_3d(ctx, type, n_embd*2, n_hc, n_tokens*3);
+            ggml_set_name(x_big, "x_big");
+            x = ggml_view_3d(ctx, x_big, n_embd, n_hc, n_tokens, x_big->nb[1], x_big->nb[2], 0);
+
+            ggml_tensor * w_big = ggml_new_tensor_2d(ctx, type, n_hc*3, n_tokens);
+            ggml_set_name(w_big, "w_big");
+            w = ggml_view_2d(ctx, w_big, n_hc, n_tokens, w_big->nb[1], 0);
+        } else if (v == 2) {
+            // model path (dsv4_hc_pre with n_tokens == 1): the weights are a strided
+            // view into the [(2 + n_hc)*n_hc, n_tokens] sinkhorn split. Use the
+            // post-gate element offset n_hc so the misalignment path is exercised too.
+            x = ggml_new_tensor_3d(ctx, type, n_embd, n_hc, n_tokens);
+
+            ggml_tensor * split = ggml_new_tensor_2d(ctx, type, (2 + n_hc)*n_hc, n_tokens);
+            ggml_set_name(split, "split");
+            w = ggml_view_2d(ctx, split, n_hc, n_tokens, split->nb[1], n_hc*split->nb[0]);
+        } else {
+            x = ggml_new_tensor_3d(ctx, type, n_embd, n_hc, n_tokens);
+            w = ggml_new_tensor_2d(ctx, type, n_hc, n_tokens);
+        }
+        ggml_set_name(x, "x");
+        ggml_set_name(w, "weights");
+
+        ggml_tensor * out = ggml_dsv4_hc_weighted_sum(ctx, x, w);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+};
