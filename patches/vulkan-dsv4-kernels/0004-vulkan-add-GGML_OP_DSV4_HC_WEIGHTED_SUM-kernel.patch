diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_weighted_sum.comp b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_weighted_sum.comp
new file mode 100644
index 0000000..33b1856
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_weighted_sum.comp
@@ -0,0 +1,59 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+// DeepSeek-V4 hyperconnection weighted sum:
+//   out[d, t] = sum_h x[d, h, t] * weights[h, t]
+// One thread per output element over ne = n_embd * n_tokens, in the same flat order
+// as ggml_compute_forward_dsv4_hc_weighted_sum (ggml-cpu/ops.cpp) and
+// kernel_dsv4_hc_weighted_sum (ggml-metal.metal), and with the same ascending-h
+// accumulation order. All strides are in elements and come from the tensors, so
+// non-contiguous views (the model's n_tokens == 1 decode path passes the weights as
+// a strided view into the sinkhorn split) work directly.
+
+layout (push_constant) uniform parameter
+{
+    uint ne;                                    // n_embd * n_tokens
+    uint n_embd;
+    uint n_hc;
+    uint nb_x0; uint nb_x1; uint nb_x2;         // x strides
+    uint nb_w0; uint nb_w1;                     // weights strides
+    uint nb_d0; uint nb_d1;                     // dst strides
+    uint x_offset; uint w_offset; uint d_offset;
+} p;
+
+layout (binding = 0) readonly  buffer X   {A_TYPE data_x[];};
+layout (binding = 1) readonly  buffer W   {A_TYPE data_w[];};
+layout (binding = 2) writeonly buffer DST {D_TYPE data_d[];};
+
+const uint num_threads = 256;
+
+layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    uint idx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
+
+    // num_threads * num_iter must equal 512, to match the wg_denoms and the idx calculation
+    const uint num_iter = 2;
+
+    [[unroll]] for (uint i = 0; i < num_iter; ++i) {
+        if (idx >= p.ne) {
+            idx += num_threads;
+            continue;
+        }
+
+        const uint d = idx % p.n_embd;
+        const uint t = idx / p.n_embd;
+
+        float acc = 0.0f;
+        for (uint h = 0; h < p.n_hc; ++h) {
+            const float xv = float(data_x[p.x_offset + d*p.nb_x0 + h*p.nb_x1 + t*p.nb_x2]);
+            const float wv = float(data_w[p.w_offset + h*p.nb_w0 + t*p.nb_w1]);
+            acc += xv * wv;
+        }
+
+        data_d[p.d_offset + d*p.nb_d0 + t*p.nb_d1] = D_TYPE(acc);
+
+        idx += num_threads;
+    }
+}
