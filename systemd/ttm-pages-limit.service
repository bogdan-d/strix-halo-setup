[Unit]
Description=Enforce the 108 GiB TTM pinned-pages cap for local LLM serving (Strix Halo)
# Deliberately depends on NOTHING and is a dependency of NOTHING critical, so a
# failure here can never delay or block boot. It only writes one sysfs number.
# Needed because the `ttm.pages_limit=` kernel cmdline value is sometimes clamped
# back toward the ~96 GiB default at boot; this re-asserts the intended cap.
# MUST write the same value as the cmdline (see README, Kernel boot parameters).

[Service]
Type=oneshot
RemainAfterExit=yes
# 28311552 pages x 4096 = 108 GiB — deliberately ~16 GiB BELOW the 124 GiB GTT
# window (amdgpu.gttsize=126976) so GPU allocations can never starve the host:
# a cap equal to all of RAM let a second model load OOM-kill the whole desktop
# with "nothing killable" (2026-08-08). Weights up to ~100 GiB still load.
# The `|| true` makes a missing path or a rejected write a silent no-op: the unit
# can never fail, cascade, or hang boot.
ExecStart=/bin/sh -c 'echo 28311552 > /sys/module/ttm/parameters/pages_limit 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
