      }">${u.state}</td></tr>`).join('');
    document.getElementById('top').innerHTML = d.top.map(p=>
      `<tr><td>${p.comm}${p.protected?' <span class=prot>&#9679;</span>':''}</td>`+
      `<td>${p.rss_mib} MiB</td></tr>`).join('');
  }catch(e){ document.getElementById('sub').textContent = 'unreachable: '+e; }
}

async function act(what){
  const out = document.getElementById('out');
  if(armed !== what){
    armed = what;
    out.textContent = 'tap the same button again within 5s to confirm "'+what+'"';
    setTimeout(()=>{ if(armed===what){armed=null; out.textContent='(confirmation expired)';} }, 5000);
    return;
  }
  armed = null;
  out.textContent = 'sending '+what+'\\u2026';
  try{
    const r = await fetch('/api/'+what,{method:'POST',headers:H});
    out.textContent = await r.text();
  }catch(e){ out.textContent = 'sent (connection dropped — expected on reboot)'; }
}

refresh(); setInterval(refresh, 5000);
</script>
"""


class Handler(BaseHTTPRequestHandler):
    server_version = "strix-guard"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        # The bookmark URL carries the token as ?t=..., and the default
        # BaseHTTPRequestHandler log line includes the full request line. Never
        # write the token to the journal — journals get shipped to backups.
        msg = re.sub(r"([?&]t=)[^\s&\"']+", r"\1<redacted>", fmt % args)
        log.info("%s %s", self.client_address[0], msg)

    def _authed(self):
        want = read_token()
        if not want:
            return False
        got = ""
        auth = self.headers.get("Authorization", "")
        if auth.startswith("Bearer "):
            got = auth[7:].strip()
        if not got:
            q = urllib.parse.urlparse(self.path).query
            got = urllib.parse.parse_qs(q).get("t", [""])[0]
        return hmac.compare_digest(got, want)

    def _send(self, code, body, ctype="text/plain; charset=utf-8"):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/healthz":                       # unauthenticated liveness
            return self._send(200, "ok\n")
        if path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if not self._authed():
            return self._send(401, "unauthorized\n")
        if path == "/api/status":
            return self._send(200, json.dumps(snapshot()), "application/json")
        return self._send(404, "not found\n")

    def do_POST(self):
        if not self._authed():
            return self._send(401, "unauthorized\n")
        path = urllib.parse.urlparse(self.path).path
        peer = self.client_address[0]

        if path == "/api/killhogs":
            killed = kill_hogs(count=1)
            if not killed:
                return self._send(200, "nothing killable "
                                       "(everything large is protected)\n")
            k = killed[0]
            tg_alert(f"strix-guard: manual kill of {k['comm']} "
                     f"(pid {k['pid']}, {k['rss_mib']} MiB) from {peer}")
            return self._send(200, f"killed {k['comm']} pid={k['pid']} "
                                   f"rss={k['rss_mib']}MiB\n")

        if path == "/api/reboot":
            log.critical("reboot requested by %s", peer)
            threading.Timer(0.5, do_graceful_reboot).start()
            return self._send(200, "graceful reboot queued — if the box is "
                                   "still up in 60s, use HARD reboot\n")

        if path == "/api/hardreboot":
            log.critical("HARD reboot requested by %s", peer)
            threading.Timer(0.5, do_hard_reboot).start()
            return self._send(200, "hard reboot (sysrq s,u,b) queued\n")

        if path.startswith("/api/restart/"):
            unit = urllib.parse.unquote(path[len("/api/restart/"):])
            ok, detail = restart_unit(unit)
            return self._send(200 if ok else 400,
                              f"{'ok' if ok else 'failed'}: {unit} {detail}\n")

        return self._send(404, "not found\n")


# --------------------------------------------------------------------------
# bind
# --------------------------------------------------------------------------

def tailscale_ip(timeout=180):
    """Wait for the tailnet address. We bind ONLY here — never 0.0.0.0."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            p = subprocess.run(["tailscale", "ip", "-4"],
                               capture_output=True, text=True, timeout=10)
            ips = (p.stdout or "").strip().splitlines()
            if ips and ips[0].startswith("100."):
                return ips[0]
        except Exception:  # noqa: BLE001
            pass
        time.sleep(3)
    return None


def main():
    if os.geteuid() != 0:
        log.error("must run as root (needs sysrq, kill, systemctl reboot)")
        return 1
    if not read_token():
        log.error("no token at %s — run install.sh", TOKEN_FILE)
        return 1

    ip = tailscale_ip()
    if not ip:
        log.error("no tailscale IPv4 after 180s; refusing to bind 0.0.0.0")
        return 1

    MemoryGuard().start()
    httpd = ThreadingHTTPServer((ip, PORT), Handler)
    httpd.daemon_threads = True
    log.info("listening on http://%s:%s (tailnet only)", ip, PORT)
    tg_alert(f"strix-guard up on http://{ip}:{PORT} — uptime {uptime_str()}")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
