<script>
const T = new URLSearchParams(location.search).get('t') || '';
const H = {'Authorization':'Bearer '+T};
let armed = null;

async function refresh(){
  try{
    const r = await fetch('/api/status',{headers:H});
    if(!r.ok){document.getElementById('sub').textContent =
      r.status===401?'bad or missing token — append ?t=YOURTOKEN':'error '+r.status; return;}
    const d = await r.json();
    document.getElementById('sub').textContent =
      d.host+' · up '+d.uptime+' · load '+d.load+' · '+d.ts;
    document.getElementById('stats').innerHTML = [
      ['Avail RAM', (d.mem_avail_mib/1024).toFixed(1)+' G'],
      ['Used', d.mem_used_pct+'%'],
      ['Dirty', (d.dirty_mib/1024).toFixed(1)+' G'],
      ['GTT', (d.gtt_used_mib/1024).toFixed(1)+' G'],
    ].map(([k,v])=>`<div class=stat><b>${v}</b><span>${k}</span></div>`).join('');
    const bar = document.getElementById('membar');
    bar.style.width = d.mem_used_pct+'%';
    bar.style.background = d.mem_used_pct>92?'#f85149':d.mem_used_pct>80?'#d29922':'#3fb950';
    document.getElementById('units').innerHTML = d.units.map(u=>
      `<tr><td>${u.unit.replace('.service','')}</td><td style="color:${
